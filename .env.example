# انسخ هذا الملف إلى .env وعدّل القيم قبل النشر
# cp .env.example .env

# كلمة مرور حساب SA في SQL Server (يجب أن تكون قوية: 8+ أحرف، حروف كبيرة/صغيرة وأرقام ورموز)
SA_PASSWORD=Your_Strong_Pass123!

# مفتاح سري لتوقيع JWT (32 حرفاً على الأقل، اجعله عشوائياً)
JWT_KEY=CHANGE_ME_to_a_long_random_secret_at_least_32_chars
